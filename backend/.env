# 伺服器埠號
PORT=4000

# ── Supabase / PostgreSQL 連線設定 ───
DATABASE_URL=postgresql://postgres.ylotqorwlrvtimmgovhn:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# 若是連線「自架 PostgreSQL」且未設定 SSL 憑證，設為 disable；
# 連 Supabase 雲端時請保持註解（預設會使用 SSL）
# PGSSLMODE=disable

# JWT 簽章密鑰，需改成一長串隨機亂碼（正式上線需更換）
JWT_SECRET=change_this_to_a_long_random_string

# 第一個管理員帳號的信箱（帳號固定為 thist，見 README 說明）
ADMIN_EMAIL=admin@example.com

# 前端網址，用於 CORS 與 Socket.io 白名單設定
FRONTEND_ORIGIN=http://localhost:5173
